      "id": "006b13e5-896a-4066-bb07-9c7585f7f561",
      "name": "Get availability in a calendar"
    },
    {
      "parameters": {
        "jsCode": "\nconst calendar = $input.first().json;\n\n// Get the original appointment details\nconst appointment = $('Validate Appointment').first().json;\n\n// Read availability from Google Calendar\nconst available = calendar.available;\n\n// Ensure Calendar returned a valid result\nif (typeof available !== 'boolean') {\n  throw new Error('Invalid Google Calendar availability response');\n}\n\n// Prepare response for Ava\nreturn [{\n  json: {\n    success: true,\n    available: available,\n    service: appointment.service,\n    date: appointment.date,\n    time: appointment.time,\n    start: appointment.start,\n    end: appointment.end,\n    time_zone: appointment.time_zone,\n    message: available\n      ? 'The requested appointment slot is available but not yet booked.'\n      : 'The requested appointment slot is unavailable. Please ask the customer to choose another time.'\n  }\n}];\n"
      },
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        688,
        -320
      ],
      "id": "29318a33-7bcc-4a23-b432-4146da91dd96",
