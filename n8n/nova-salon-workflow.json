      ],
      "id": "ac669a42-be1d-47c3-a444-6e168ef0739b",
      "name": "Return Invalid Request"
    },
    {
      "parameters": {
        "jsCode": "\nconst body = $input.first().json.body || {};\nconst zone = 'Asia/Karachi';\n\n// Salon services and appointment durations\nconst services = {\n  haircut: 45,\n  blowout: 45,\n  coloring: 120,\n  conditioning: 30\n};\n\nconst service = String(body.service || '').trim().toLowerCase();\nconst date = String(body.date || '').trim();\nconst time = String(body.time || '').trim();\n\nfunction reject(message) {\n  return [{\n    json: {\n      valid: false,\n      available: false,\n      message\n    }\n  }];\n}\n\n// Check service\nif (!services[service]) {\n  return reject('Invalid salon service.');\n}\n\n// Check date and time format\nif (!/^\\d{4}-\\d{2}-\\d{2}$/.test(date) ||\n    !/^([01]\\d|2[0-3]):[0-5]\\d$/.test(time)) {\n  return reject('Invalid date or time format.');\n}\n\n// Interpret appointment in Islamabad, Pakistan timezone\nconst start = DateTime.fromISO(`${date}T${time}`, { zone });\n\nif (!start.isValid ||\n    start.toFormat('yyyy-MM-dd') !== date ||\n    start.toFormat('HH:mm') !== time) {\n  return reject('Invalid appointment date or time.');\n}\n\nconst duration = services[service];\nconst end = start.plus({ minutes: duration });\n\n// Salon is open Tuesday through Saturday\nif (start.weekday < 2 || start.weekday > 6) {\n  return reject('Nova Salon is closed on Sunday and Monday.');\n}\n\n// Opening hours: 9 AM to 6 PM\nif (\n  start.hour < 9 ||\n  end.toISODate() !== start.toISODate() ||\n  end.hour > 18 ||\n  (end.hour === 18 && end.minute > 0)\n) {\n  return reject('Appointment is outside salon working hours.');\n}\n\n// Minimum 2 hours' notice\nconst now = DateTime.now().setZone(zone);\n\nif (start.toMillis() < now.plus({ hours: 2 }).toMillis()) {\n  return reject('Appointments require at least 2 hours notice.');\n}\n\n// Maximum 30 days in advance\nif (start.toMillis() > now.plus({ days: 30 }).toMillis()) {\n  return reject('Appointments can only be booked 30 days ahead.');\n}\n\n// Valid appointment request\nreturn [{\n  json: {\n    valid: true,\n    service,\n    date,\n    time,\n    duration_minutes: duration,\n    start: start.toISO(),\n    end: end.toISO(),\n    time_zone: zone\n  }\n}];\n"
      },
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        16,
