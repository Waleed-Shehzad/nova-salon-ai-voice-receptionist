      "name": "Customer Confirmed?"
    },
    {
      "parameters": {
        "jsCode": "\nconst event = $input.first().json;\nconst request = $('Receive Availability Request').first().json.body;\n\n// Verify that Google Calendar created an event\nif (!event.id) {\n  throw new Error('Google Calendar did not return an event ID.');\n}\n\nreturn [{\n  json: {\n    success: true,\n    booked: true,\n    booking_id: event.id,\n    customer_name: request.customer_name,\n    customer_email: request.customer_email,\n    service: request.service,\n    date: request.date,\n    time: request.time,\n    time_zone: 'Asia/Karachi',\n    message: `Appointment successfully booked for ${request.customer_name}.`\n  }\n}];\n"
      },
